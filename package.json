{
  "name": "freemium-deploy",
  "version": "1.0.0",
  "description": "Build Free and Pro (premium) distributables of a WordPress theme/plugin from a single source using inline premium markers. CLI + library.",
  "type": "module",
  "bin": {
    "deploy-version": "bin/cli.js"
  },
  "main": "src/index.js",
  "exports": {
