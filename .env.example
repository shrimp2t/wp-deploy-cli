# ─────────────────────────────────────────────────────────────────────────────
# wp-deploy-cli — example configuration
#
# Copy this file to `.env` and fill in your values:
#     cp .env.example .env
#
# `deploy-version` auto-loads `.env` from the current directory and uses these
# as DEFAULTS. Any matching --flag on the command line overrides its variable,
# and real environment variables (e.g. in CI) always win over the file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Build config (DEPLOY_* — optional; use instead of a deploy.json file) ────
# These mirror deploy.json fields (arrays are comma-separated). Uncomment to put
# the whole build config here; env values win over a deploy.json if both exist.
#
# Pro-only product? Set DEPLOY_SINGLE=true: one build named by its slug (no "-pro"),
# no free variant, no SVN, and DEPLOY_FUNCTION_PREMIUM / premium markers not needed.
# DEPLOY_SINGLE=true
# DEPLOY_TYPE=plugin
# DEPLOY_NAME=my-plugin
# DEPLOY_PREMIUM_NAME=my-plugin-pro
# DEPLOY_FUNCTION_PREMIUM=my_plugin_is__premium
# DEPLOY_PREMIUM_SUFFIX=pro
# DEPLOY_REPLACE=SUFFIX
# DEPLOY_REPLACE_PRO=Pro
# DEPLOY_REPLACE_FREE=
# DEPLOY_PREMIUM_ONLY=/pro/,/includes/pro/
# DEPLOY_PREMIUM_FILES=/includes/class-pro-feature.php

# ── GitHub release (via the gh CLI — run `gh auth login` once) ───────────────
# Create/update a GitHub release for this project and upload the built zips.
# This is the config-file equivalent of the --github-publish flag.
GITHUB_PUBLISH=true
# Target repo (owner/name). Leave empty to auto-detect from the project's git origin.
GITHUB_REPO=
# Release tag. Leave empty to use v<version> (from the theme/plugin header).
GITHUB_TAG=
# Only needed in CI (the gh CLI reads it); locally gh uses your `gh auth login`.
# GH_TOKEN=

# ── EDD site (updated after deploy) via WordPress core REST ──────────────────
# Uses the EXISTING endpoint EDD exposes: /wp-json/wp/v2/edd-downloads/<id>
# Auth = WordPress core Application Passwords (no plugin). Generate one at
# Users > Profile > Application Passwords, then paste it below (spaces are fine).
# To write the SL version/changelog, install the tiny meta-registration mu-plugin
# from examples/ once — it enables those existing fields for REST (no new route).
WP_URL=https://your-edd-site.com
WP_USER=admin
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
# WP_REST_BASE=edd-downloads   # default; change only if customized

# EDD download IDs to update after a successful build.
EDD_DOWNLOAD_ID=123          # pro (premium) download id
EDD_DOWNLOAD_FREE_ID=456     # free download id

# Which download-file slot (ID/index) to write, for downloads that have several
# files. Default 0. Other files on the download are preserved.
# EDD_FILE_ID=0              # pro download's file slot
# EDD_FILE_FREE_ID=0         # free download's file slot

# ── Companion plugin API (upload zip + set the download file) ────────────────
# Install wordpress-plugin/wp-deploy-endpoint.php on the EDD site, then set the
# site's base URL below — /wp-json/wp-deploy/v1/download is appended automatically.
FD_API_URL=https://your-edd-site.com
# Auth: a WordPress Application Password (Users > Profile > Application Passwords).
FD_API_USER=admin
FD_API_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
# FD_INSECURE_TLS=false        # true to allow self-signed certs (local Studio)

# ── Fallback: custom JSON endpoint (src/edd.js) ──────────────────────────────
# EDD_ENDPOINT=https://your-edd-site.com/wp-json/wp-deploy/v1/sync
# EDD_TOKEN=change-me-to-a-long-random-secret

# ── WordPress.org SVN (deploy the FREE build) ────────────────────────────────
# Fill ALL three (slug + user + password) to also publish the free build to wp.org.
# SVN then runs automatically (like EDD runs when FD_API_URL is set); force with --svn.
# SVN_SLUG=your-theme-or-plugin-slug
# SVN_USER=your-wporg-username
# SVN_PASSWORD=your-wporg-password
# SVN_URL=            # override; default plugins.svn/themes.svn by type
# SVN_MESSAGE=Release

# ── Build (optional) ─────────────────────────────────────────────────────────
# Default output directory. Leave empty to use a sibling "dist/" of the source.
OUT_DIR=
