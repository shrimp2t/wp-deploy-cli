# ─────────────────────────────────────────────────────────────────────────────
# freemium-deploy — example configuration
#
# Copy this file to `.env` and fill in your values:
#     cp .env.example .env
#
# `deploy-version` auto-loads `.env` from the current directory and uses these
# as DEFAULTS. Any matching --flag on the command line overrides its variable,
# and real environment variables (e.g. in CI) always win over the file.
# ─────────────────────────────────────────────────────────────────────────────

# ── GitHub (release source + asset upload) ───────────────────────────────────
# Personal access token with `repo` scope. In GitHub Actions use the built-in
# GITHUB_TOKEN secret instead of hardcoding one here.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Default repo to build from / publish to (owner/name). --github-repo overrides.
GITHUB_REPO=FameThemes/easymag

# Default release tag to build (e.g. v1.3.7). --github-tag overrides.
GITHUB_TAG=

# Upload the built free/pro zips as assets of that release: true / false.
GITHUB_PUBLISH=false

# ── EDD site (where downloads are updated after deploy) ──────────────────────
# The site you upload/sync to once a build finishes. Point this at a small
# companion REST route on your EDD site (see README → "EDD sync") that receives
# the deploy payload and updates the download files + version + changelog.
EDD_ENDPOINT=https://your-edd-site.com/wp-json/freemium-deploy/v1/sync

# Shared secret sent as `Authorization: Bearer <token>`; verify it on the site.
EDD_TOKEN=change-me-to-a-long-random-secret

# EDD download IDs to update after a successful build.
EDD_DOWNLOAD_ID=123          # pro (premium) download id
EDD_DOWNLOAD_FREE_ID=456     # free download id

# ── Build (optional) ─────────────────────────────────────────────────────────
# Default output directory. Leave empty to use a sibling "dist/" of the source.
OUT_DIR=
