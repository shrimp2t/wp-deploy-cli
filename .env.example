# ─────────────────────────────────────────────────────────────────────────────
# freemium-deploy — example configuration
#
# Copy this file to `.env` and fill in your values:
#     cp .env.example .env
#
# `deploy-version` auto-loads `.env` from the current directory and uses these
# as DEFAULTS. Any matching --flag on the command line overrides its variable,
# and real environment variables (e.g. in CI) always win over the file.
# ─────────────────────────────────────────────────────────────────────────────

# ── GitHub (release source + asset upload) ───────────────────────────────────
# Personal access token with `repo` scope. In GitHub Actions use the built-in
# GITHUB_TOKEN secret instead of hardcoding one here.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Default repo to build from / publish to (owner/name). --github-repo overrides.
GITHUB_REPO=FameThemes/easymag

# Default release tag to build (e.g. v1.3.7). --github-tag overrides.
GITHUB_TAG=

# Upload the built free/pro zips as assets of that release: true / false.
GITHUB_PUBLISH=false

# ── EDD site (updated after deploy) via WordPress core REST ──────────────────
# Uses the EXISTING endpoint EDD exposes: /wp-json/wp/v2/edd-downloads/<id>
# Auth = WordPress core Application Passwords (no plugin). Generate one at
# Users > Profile > Application Passwords, then paste it below (spaces are fine).
# To write the SL version/changelog, install the tiny meta-registration mu-plugin
# from examples/ once — it enables those existing fields for REST (no new route).
WP_URL=https://your-edd-site.com
WP_USER=admin
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
# WP_REST_BASE=edd-downloads   # default; change only if customized

# EDD download IDs to update after a successful build.
EDD_DOWNLOAD_ID=123          # pro (premium) download id
EDD_DOWNLOAD_FREE_ID=456     # free download id

# ── Companion plugin API (upload zip + set the download file) ────────────────
# Install wordpress-plugin/freemium-deploy-endpoint.php on the EDD site, then set:
FD_API_URL=https://your-edd-site.com/wp-json/freemium-deploy/v1/download
# Auth: either a shared token (define FD_API_TOKEN on the site) …
FD_API_TOKEN=change-me-to-a-long-random-secret
# … or an Application Password:
# FD_API_USER=admin
# FD_API_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
# FD_INSECURE_TLS=false        # true to allow self-signed certs (local Studio)

# ── Fallback: custom JSON endpoint (src/edd.js) ──────────────────────────────
# EDD_ENDPOINT=https://your-edd-site.com/wp-json/freemium-deploy/v1/sync
# EDD_TOKEN=change-me-to-a-long-random-secret

# ── Build (optional) ─────────────────────────────────────────────────────────
# Default output directory. Leave empty to use a sibling "dist/" of the source.
OUT_DIR=
