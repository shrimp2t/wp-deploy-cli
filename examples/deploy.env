# Complete example .env for deploying ONE theme/plugin end-to-end.
# Copy into the theme/plugin folder as `.env` (it is auto-loaded) and fill in.
# Precedence: CLI flag > this file > real environment. Keep .env out of git.

# ── Pro build -> EDD download (upload zip + set file + SL version/changelog) ──
# Install wordpress-plugin/wp-deploy-endpoint.php on the EDD site and activate it.
FD_API_URL=https://shop.example.com/wp-json/wp-deploy/v1/download
# Auth: a WordPress Application Password (Users > Profile > Application Passwords).
FD_API_USER=admin
FD_API_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
# FD_INSECURE_TLS=false            # true only for local self-signed (Studio) sites

# EDD download IDs to update (create the two products first, then paste their IDs).
EDD_DOWNLOAD_ID=42                 # pro (premium) download
EDD_DOWNLOAD_FREE_ID=43            # free download (optional; usually free ships on wp.org)

# ── Free build -> WordPress.org SVN ──────────────────────────────────────────
SVN_SLUG=my-theme                  # your approved wp.org slug
SVN_USER=your-wporg-username
SVN_PASSWORD=your-wporg-password
# SVN_MESSAGE=Release

# ── GitHub release of the built zips (via the gh CLI) ────────────────────────
# Create/update a release for this project and upload the free/pro zips.
GITHUB_PUBLISH=true
# Target repo; leave empty to auto-detect from this project's git origin.
GITHUB_REPO=owner/my-theme
# Release tag; leave empty to use v<version>.
# GITHUB_TAG=v1.0.0
# gh handles auth locally (gh auth login); in CI set GH_TOKEN instead.
# GH_TOKEN=

# ── (optional) default output dir; else a sibling dist/ of the source ────────
# OUT_DIR=
