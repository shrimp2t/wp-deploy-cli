# Example .env for a PRO-ONLY plugin/theme (no free version, no wp.org SVN).
# Copy into the product folder as `.env`. One build is produced, named by its
# slug, and shipped to the EDD store (and optionally a GitHub release).
#
# Note: no DEPLOY_FUNCTION_PREMIUM / premium markers are needed here — there is
# no free/pro split to resolve.

# ── Build config ─────────────────────────────────────────────────────────────
DEPLOY_SINGLE=true                 # one build, plain slug, no free variant, no SVN
DEPLOY_TYPE=plugin                 # or "theme"
DEPLOY_NAME=my-pro-plugin          # output slug (default: source folder name)

# ── Pro build -> EDD download ────────────────────────────────────────────────
FD_API_URL=https://shop.example.com
FD_API_USER=admin
FD_API_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
EDD_DOWNLOAD_ID=42

# ── (optional) GitHub release of the built zip ───────────────────────────────
GITHUB_PUBLISH=true
# GITHUB_REPO=owner/my-pro-plugin  # optional; auto-detected from git origin
